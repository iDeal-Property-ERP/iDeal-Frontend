# Copy this file to `.env.local` for local dev. See docs/local-setup.md.
# Only NEXT_PUBLIC_* vars are exposed to the browser. They are inlined at build time.

# Next.js
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Public marketplace requests use this absolute URL (no trailing slash).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010/api/v1
# Server-only destination for same-origin /api/v1 requests (no API path).
BACKEND_ORIGIN=http://127.0.0.1:8010
# Direct local ASGI connection. Unset or leave empty in deployed environments
# to use ws(s)://<frontend-host>/ws/v1/chat/ through the deployment proxy.
NEXT_PUBLIC_CHAT_WS_URL=ws://127.0.0.1:8010/ws/v1/chat/
# Optional; leave empty to use the map fallback UI.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_LOGGING_LEVEL=info
